# .env.local — from `vercel env pull` (don't hand-edit)
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
TMDB_READ_ACCESS_TOKEN=""
BETTER_AUTH_SECRET=""

# Required on hosted Preview and Production; locally codes print to the terminal
RESEND_API_KEY=""

# Explicitly disposable database only. Prefer exporting this in the test shell;
# tests never fall back to DATABASE_URL or overwrite it with .env.local values.
TEST_DATABASE_URL=""

# Vercel supplies VERCEL_ENV; usually leave it unset locally.
